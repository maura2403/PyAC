<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gestión de Alumnos - Tabla de alumnos</title>
    <link rel="stylesheet" href="/css/mainMenu.css">
</head>

<body>
    <table>
        <tr>
            <% for (const [key, meta] of Object.entries(studentColumnMeta)) { %>
                <th><%= meta.label %></th>
            <% } %>
        </tr>
        <% for (const student of students) { %>
            <tr>
                <% for (const [key, meta] of Object.entries(studentColumnMeta)) { %>
                    <td><%=student[key]%></td>
                <% } %>
                <td><button onclick="deleteStudent(<%= student.id_alumno %>)">Eliminar</button></td>
            </tr>
        <% } %>
    </table>
    <form method="POST" action="/api/alumnos">
        <% for (const [key, meta] of Object.entries(studentColumnMeta)) { %>
            <%= meta.label %> <input type="<%= meta.type %>" name="<%= key %>" value="<%= meta.value%>"><br>
        <% } %>
        <input type="submit">
    </form>

</body>

<script>
async function deleteStudent(dni){
    if (confirm(`¿Desea eliminar al alumno con DNI: ${dni}?`)){
        const response = await fetch(`/api/alumnos/${dni}`, {
            method: 'DELETE'
        });
    }
}
</script>
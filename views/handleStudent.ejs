<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gestión de Alumnos - Menú Principal</title>
    <link rel="stylesheet" href="/css/mainMenu.css">
</head>

<body>
    <table>
        <tr>
            <th>id</th>
            <th>nombre</th>
            <th>apellido</th>
        </tr>
        <% for (let i = 0; i < alumnos.length; i++) { %>
            <tr>
                <td><%=alumnos[i].id_alumno%></td>
                <td><%=alumnos[i].nombre%></td>
                <td><%=alumnos[i].apellido%></td>
            </tr>
        <% } %>
    </table>
    <form method="POST" action="/app/v0/agregar-alumno">
        Nombre: <input type="text" name="name"><br>
        Apellido: <input type="text" name="lastName"><br>
        <input type="submit">
    </form>
</body>
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gestión de Alumnos - Menú Principal</title>
    <link rel="stylesheet" href="/css/mainMenu.css">

    <%- include('partials/head') %>
</head>

<body id="gradientBG">

    <!--Main Content-->
    <header class="container vh-50 d-flex justify-content-center align-items-center">
        <div class="d-flex flex-column justify-content-center align-items-center">
            <h1 class="display-1 my-5 text-uppercase fw-bold">Gestión de Alumnos</h1>
            <img src="/img/logoInstituto.png" alt="logoInstituto" class="w-25">
            <a href="/about" class="btn btn-primary w-25" style="margin-bottom:1%">Acerca del Sistema</a>
        </div>
    </header>

    <!-- Menú principal con acordeón -->
    <div id="alumnos" class="componenteMenu">
        <div class="d-flex align-items-center component-div">
            <h1>REGISTRO DE ALUMNOS</h1>
            <div class="accordion vh-80 w-75" id="accordionPanelsStayOpenExample" data-bs-theme="dark">

                <!-- Registro de alumnos -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#registroAlumnos" aria-expanded="true"
                            aria-controls="registroAlumnos">
                            Alta de Alumnos
                        </button>
                    </h2>
                    <div id="registroAlumnos" class="accordion-collapse collapse">
                        <div class="accordion-body">
                            <strong>Registro de alumnos nuevos.</strong> Permite dar de alta estudiantes,
                            registrando sus datos personales, curso y división.
                        </div>
                        <a href="/alumnos/alta" class="btn btn-warning btn-lg btn-block boton-acordeon">Ir al registro de alumnos</a>
                    </div>
                </div>

                <!-- Toma de asistencia -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#tomaAsistencia" aria-expanded="false"
                            aria-controls="tomaAsistencia">
                            Toma de Asistencia
                        </button>
                    </h2>
                    <div id="tomaAsistencia" class="accordion-collapse collapse">
                        <div class="accordion-body">
                            <strong>Gestión de asistencia.</strong> Permite marcar la asistencia diaria de los alumnos
                            y generar reportes de faltas o llegadas tarde.
                        </div>
                        <a href="/asistencia" class="btn btn-warning btn-lg btn-block boton-acordeon">Ir a toma de asistencia</a>
                    </div>
                </div>

                <!-- Reportes -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#reportes" aria-expanded="false"
                            aria-controls="reportes">
                            Reportes y Estadísticas
                        </button>
                    </h2>
                    <div id="reportes" class="accordion-collapse collapse">
                        <div class="accordion-body">
                            <strong>Consultas de información.</strong> Permite generar informes de asistencia por curso,
                            historial de un alumno y estadísticas globales.
                        </div>
                        <a href="/reportes" class="btn btn-warning btn-lg btn-block boton-acordeon">Ir a reportes</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ABM genérico -->
    <div id="abm" class="d-flex justify-content-center align-items-center" data-bs-theme="dark">
        <div class="card">
            <h1 class="card-header"><strong>SECCIÓN DE ABM</strong></h1>
            <div class="card-body" style="background-color:white;color:black;">
                <h5 class="card-title">Altas, Bajas y Modificaciones</h5>
                <p class="card-text">Permite gestionar cambios en los registros de alumnos, cursos y asistencia.</p>
                <div style="text-align:center">
                    <a href="/abm_menu" class="btn btn-primary">Ir al menú principal del ABM</a>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>

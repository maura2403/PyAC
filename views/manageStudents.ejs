<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gestión de Alumnos - Tabla de alumnos</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/pages/manageStudents.css">
</head>
<body>
    <%- include('partials/nav') %>
    <main>
    <div class="table-wrapper">
    <table>
        <thead>
        <tr>
            <% for (const [key, meta] of Object.entries(metadata)) { %>
            <th><%= meta.label %></th>
            <% } %>
            <th><button class="add" onclick="startAddingStudent()">+</button></th>
        </tr>
        </thead>
        <tbody>
        <tr id="add-student-row">
            <% for (const [key, meta] of Object.entries(metadata)) { %>
            <td data-label="<%= meta.label %>" data-key="<%=key%>"><input type="text"></td>
            <% } %>
            <td>
                <button class="confirm" onclick="addNewStudent()"></button>
                <button class="delete" onclick="cancelAddingStudent()"></button>
            </td>
        </tr>
        <% for (const student of students) { %>
        <tr data-id="<%=student.dni%>">
            <% for (const [key, meta] of Object.entries(metadata)) { %>
                <td data-label="<%= meta.label %>" data-key="<%=key%>"><%=student[key]%></td>
            <% } %>
            <td>
                <button class="edit" onclick="startEditingStudent(this)"></button>
                <button class="delete" onclick="deleteStudent(this)"></button>
            </td>
        </tr>
        <% } %>
        </tbody>
    </table>
    </div>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/manageStudents.js"></script>
    <script src="/js/nav.js"></script>
</body>

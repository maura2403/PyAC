<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gestión de Alumnos - Tabla de alumnos</title>
    <link rel="stylesheet" href="/css/manageStudents.css">
</head>

<body>
    <table>
        <tr>
            <% for (const [key, meta] of Object.entries(studentColumnMeta)) { %>
            <th><%= meta.label %></th>
            <% } %>
            <th><button class="add">+</button></th>
        </tr>
        <% for (const student of students) { %>
        <tr>
            <% for (const [key, meta] of Object.entries(studentColumnMeta)) { %>
                <td><%=student[key]%></td>
            <% } %>
            <td>
                <button class="edit"></button>
                <!--TODO: cambiar como pasamos este parametro, tiene que haber una mejor manera de hacerlo-->
                <button class="delete" onclick="deleteStudent(<%= student.id_alumno %>)"></button>
            </td>
        </tr>
        <% } %>
    </table>
</body>


<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gestión de Alumnos - Tabla de alumnos</title>
    <link rel="stylesheet" href="/css/manageStudents.css">
</head>
<body>
    <table>
        <tr>
            <% for (const [key, meta] of Object.entries(studentColumnMeta)) { %>
            <th><%= meta.label %></th>
            <% } %>
            <th><button class="add" onclick="startAddingStudent()">+</button></th>
        </tr>
        <tr id="add-student-row">
            <% for (const [key, meta] of Object.entries(studentColumnMeta)) { %>
            <td data-key="<%=key%>"><input type="text"></td>
            <% } %>
            <td>
                <button class="confirm" onclick="addNewStudent()"></button>
                <button class="delete" onclick="cancelAddingStudent()"></button>
            </td>
        </tr>
        <% for (const student of students) { %>
        <tr data-id="<%=student.dni%>">
            <% for (const [key, meta] of Object.entries(studentColumnMeta)) { %>
                <td data-key="<%=key%>"><%=student[key]%></td>
            <% } %>
            <td>
                <button class="edit" onclick="startEditingStudent(this)"></button>
                <button class="delete" onclick="deleteStudent(this)"></button>
            </td>
        </tr>
        <% } %>
    </table>
</body>
<script src="/js/manageStudents.js"></script>
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gestión de Alumnos - Editar datos del alumno</title>
    <link rel="stylesheet" href="/css/mainMenu.css">
</head>

<h2>Editar Alumno</h2>
<form method="POST" action="/api/alumnos/editar/<%= student.dni %>">
    <% for (const [key, meta] of Object.entries(studentColumnMeta)) { %>
        <%= meta.label + ':' %>
        <input
            type="<%= meta.type %>"
            name="<%= key %>"
            value="<%= student[key]%>"
            <%= meta.modificable ? '' : 'readonly' %>
        ><br>
    <% } %>
    <input type="submit" value="Actualizar">
</form>
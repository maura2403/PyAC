<!-- Se usa para el BODY del formato generico de CRUD. Requiere recibir las variables:
 c,r,u,d -> Booleanos que indican que funcionalidades implementa la pantalla
 metadata -> Metadatos del iterable
 data -> Algún iterable, como students
 postRoute -> Una ruta para hacer post al añadir un elemento (sin /api). Por ejemplo /alumno
-->
 
<a href="/" class="btn">Regresar al Menú Principal</a>
    <table>
        <tr>
            <% for (const [key, meta] of Object.entries(metadata)) {
            if(key === 'activo') continue; // Salteamos la columna activo (si hubiese)
            %>
            <th><%= meta.label %></th>
            <% } %>
            <th>
                <% if (c === true) {%>
                <button class="add" onclick="startAdding()">NEW</button>
                <% } %>
                <% if (c === false) { %>
                ACCIONES
                <% } %>
            </th>
        </tr>
        <tr id="add-row">
            <% for (const [key, meta] of Object.entries(metadata)) { 
                if (key === 'activo') continue;    
            %>
            <td data-key="<%=key%>"><input type="text"></td>
            <% } %>
            <% if (c === true) { %>
            <td>
                <button class="confirm" onclick="addNew('<%=route%>')">CF</button>
                <button class="delete" onclick="cancelAdding()">CC</button>
            </td>
            <% } %>
        </tr>
        <% for (const element of iterableData) { %>
        <tr data-id="<%=element[idCampo]%>">
            <% for (const [key, meta] of Object.entries(metadata)) { 
                if(key === 'activo') continue;    
            %>
                <td data-key="<%=key%>"><%=element[key]%></td>
            <% } %>
            
            <% if (u === true || d === true) { %>
            <td>
                
                <% if (u === true) { %>
                <button class="edit" data-route='<%- JSON.stringify(route) %>' data-pks='<%- JSON.stringify(primaryKeys) %>'
                    onclick="startEditing(this)">E</button>
                <% } %>
                
                <% if (d === true) { %>
                <button class="delete"
                        data-route='<%- JSON.stringify(route) %>'
                        data-pks='<%- JSON.stringify(primaryKeys) %>'
                        onclick="deleteRow(this)">D</button>
                <% } %>
            </td>
            <% } %>
        </tr>
        <% } %>
    </table>


<script src="/js/addInCRUD.js"></script>
<script src="/js/updateInCRUD.js"></script>
<script src="/js/deleteInCRUD.js"></script>